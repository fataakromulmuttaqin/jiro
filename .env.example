# =============================================================================
# Jiro — environment variables
# Copy to .env (don't commit) and fill in. Anything left blank disables the
# corresponding feature safely — the bot will still run in alert-only mode.
# =============================================================================

# ---- LLM (Grok) ----
# REQUIRED for narrative scanning. Get one at https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4-latest

# ---- Telegram alerts (optional) ----
# If both are set, gap alerts and position opens/closes get sent there.
# Create a bot via @BotFather, send /start, then grab chat_id via
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Solana RPC ----
# PRIMARY: Helius (free tier supports ~50k req/day, plenty for paper trade).
# Get a free key at https://helius.dev — copy the URL they give you, which
# looks like https://mainnet.helius-rpc.com/?api-key=XXXXX
RPC_URL=

# BACKUPS (comma-separated, tried in order after primary fails).
# Add at least one of these so the bot doesn't go silent when Helius hiccups:
#   QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/XXXXX/
#   Triton:    https://your-endpoint.triton.one/
#   Public:    https://api.mainnet-beta.solana.com (no key, heavily rate-limited)
RPC_FALLBACK_URLS=

# Per-RPC timeout & failure cooldown (seconds). Defaults are sane.
# RPC_TIMEOUT_S=8
# RPC_COOLDOWN_S=30

# ---- Trading ----
# These two together are required for the bot to take any real action.
# Until you set both, it runs in alert-only / paper-trade mode regardless
# of what config.json says. config.json CANNOT enable live trading.

# Set to "true" only when you're ready to actually place orders.
AUTO_TRADE_ENABLED=false

# Dry-run simulates buys/sells (prints what it WOULD do, sends no tx).
# Keep this "true" until you've watched several days of paper logs.
# config.json can lower position_size_usd for paper; do not enable real
# trades with a 50 USD size before reading the README.
DRY_RUN=true

# ---- LIVE-TRADE ARM TOKEN (safety gate) ----
# Even with AUTO_TRADE_ENABLED=true and DRY_RUN=false, the bot will REFUSE
# to sign transactions unless this exact token is present. This guards
# against accidental live mode from a copy-paste or stale .env.
# To actually go live, you must BOTH set this token AND have a wallet key.
ARM_LIVE_TRADE=

# ---- Wallet (BURNER only, never your main) ----
# Base58 secret key of a dedicated Solana wallet funded only with what you
# can afford to lose entirely. Do not reuse your main wallet.
SOLANA_PRIVATE_KEY=

# ---- Refuse list (optional, defense-in-depth) ----
# Comma-separated pubkeys that the bot will REFUSE to sign for, even if
# the env is otherwise armed. Use this to lock out your main wallet so a
# mistake can never send from it.
# REFUSE_PUBKEYS=YourMainWalletPubkey111,AnotherWallet222

# =============================================================================
# Quick start
# =============================================================================
# 1) cp .env.example .env && nano .env
# 2) Fill in XAI_API_KEY, RPC_URL, RPC_FALLBACK_URLS (at least one backup)
# 3) Leave AUTO_TRADE_ENABLED=false, DRY_RUN=true for paper mode
# 4) Optional: fill in TELEGRAM_* to receive gap alerts and trade signals
# 5) Run scanner only:    python3 gap_finder_bot.py --loop
# 6) Run scanner+monitor:  python3 gap_finder_bot.py --loop --with-monitor
# 7) To go live: read README.md "Setup (auto-trading)" first, then set
#    AUTO_TRADE_ENABLED=true, DRY_RUN=false, ARM_LIVE_TRADE=<token above,
#    SOLANA_PRIVATE_KEY=<burner key>
# =============================================================================